-c
situation_dll.c
-o
build/dll/situation_dll_vulkan.o
-std=c11
-msse
-msse2
-msse4.1
-I.
-Iext
-Iext/vulkan
-Iext/cgltf
-Iext/cglm/include
-Iext/glfw/include
-Iext/glfw/deps
-Isit/k-term
-IC:\VulkanSDK\1.4.313.2/Include
-DSITUATION_USE_VULKAN
-DCGLM_FORCE_DEPTH_ZERO_TO_ONE
-DSITUATION_ENABLE_THREADING
-DSITUATION_ENABLE_SHADER_COMPILER
-DSITUATION_BUILD_SHARED
-DKTERM_BUILD_SHARED
-DKTERM_IMPLEMENTATION
