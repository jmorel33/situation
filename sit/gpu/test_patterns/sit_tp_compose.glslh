#ifndef SIT_TP_COMPOSE_GLSLH
#define SIT_TP_COMPOSE_GLSLH

#include "sit/gpu/test_patterns/sit_tp_config.glslh"
#include "sit/gpu/test_patterns/sit_tp_smpte.glslh"
#include "sit/gpu/test_patterns/sit_tp_convergence.glslh"
#include "sit/gpu/test_patterns/sit_tp_gradients.glslh"
#include "sit/gpu/test_patterns/sit_tp_pluge.glslh"
#include "sit/gpu/test_patterns/sit_tp_multiburst.glslh"
#include "sit/gpu/test_patterns/sit_tp_crosshatch.glslh"
#include "sit/gpu/test_patterns/sit_tp_cube.glslh"
#include "sit/gpu/test_patterns/sit_tp_primitives.glslh"

vec3 sit_tp_pattern_checkerboard_ex(vec2 uv, SitTpConfig cfg, SitTpPalette pal, SitTpParamsChecker p) {
    vec2 res = vec2(cfg.width, cfg.height);
    vec4 screen = vec4(0.0, 0.0, res.x, res.y);
    vec2 tile = max(vec2(p.tile_size_x, p.tile_size_y), vec2(1.0));
    vec3 ca = sit_tp_vec3_from_rgba(p.color_a);
    vec3 cb = sit_tp_vec3_from_rgba(p.color_b);
    return sit_tp_checkerboard(uv, res, screen, tile, ca, cb);
}

vec3 sit_tp_pattern_checkerboard(vec2 uv, SitTpConfig cfg, SitTpPalette pal) {
#if defined(SIT_TP_USE_LAYER_SSBO)
    return sit_tp_pattern_checkerboard_ex(uv, cfg, pal, u_sit_tp_layers.checker);
#else
    SitTpParamsChecker p;
    p.tile_size_x = cfg.checker_size.x;
    p.tile_size_y = cfg.checker_size.y;
    p.color_a = vec4(pal.bar_white, 1.0);
    p.color_b = vec4(pal.bar_black, 1.0);
    return sit_tp_pattern_checkerboard_ex(uv, cfg, pal, p);
#endif
}

vec3 sit_tp_apply_layer(vec3 base, vec2 uv, SitTpConfig cfg, SitTpPalette pal, int layer_index) {
    if (layer_index == int(SIT_TP_SMPTE_BARS)) {
        return sit_tp_smpte_bars_on(base, uv, cfg, pal);
    }
    if (layer_index == int(SIT_TP_CHECKERBOARD)) {
        return sit_tp_pattern_checkerboard(uv, cfg, pal);
    }
    if (layer_index == int(SIT_TP_CONVERGENCE)) {
        return sit_tp_convergence(uv, cfg, pal);
    }
    if (layer_index == int(SIT_TP_GRADIENTS)) {
        return sit_tp_gradients(uv, cfg, pal);
    }
    if (layer_index == int(SIT_TP_GRID_ONLY)) {
        vec2 res = vec2(cfg.width, cfg.height);
#if defined(SIT_TP_USE_LAYER_SSBO)
        SitTpParamsGrid gp = u_sit_tp_layers.grid;
#else
        SitTpParamsGrid gp;
        gp.spacing_px = 0.0;
        gp.line_alpha = 100.0 / 255.0;
        gp.line_color = vec4(pal.grid_white, 1.0);
#endif
        float spacing = gp.spacing_px > 0.0 ? gp.spacing_px : (res.x / 32.0);
        float g = sit_tp_grid_line(uv, res, vec2(spacing), vec2(0.0), 1.0);
        vec3 line = sit_tp_vec3_from_rgba(gp.line_color);
        return sit_tp_lerp3(base, line, g * gp.line_alpha);
    }
    if (layer_index == int(SIT_TP_PLUGE)) {
        return sit_tp_pluge_on(base, uv, cfg, pal);
    }
    if (layer_index == int(SIT_TP_CROSSHATCH)) {
        return sit_tp_crosshatch_on(base, uv, cfg, pal);
    }
    if (layer_index == int(SIT_TP_MULTIBURST)) {
        return sit_tp_multiburst_on(base, uv, cfg, pal);
    }
    if (layer_index == int(SIT_TP_3D_GRID)) {
        return sit_tp_cube(uv, cfg, pal);
    }
    return base;
}

vec3 sit_tp_compose_stack(vec2 uv, SitTpConfig cfg, SitTpPalette pal) {
    uint L = sit_tp_calibration_layers(uint(cfg.pattern_layers));
    int count = u_sit_tp_cfg.layer_stack_count;

    if (sit_tp_layer_on(L, uint(SIT_TP_3D_GRID)) && bitCount(L) == 1u) {
        return sit_tp_cube(uv, cfg, pal);
    }

    vec3 col = pal.bg_dark_gray;

    for (int i = 0; i < count && i < 9; ++i) {
        int layer = sit_tp_stack_layer_at(i);
        if (layer > 8) {
            continue;
        }
        if (!sit_tp_layer_on(L, uint(layer))) {
            continue;
        }
        col = sit_tp_apply_layer(col, uv, cfg, pal, layer);
    }

    if (cfg.show_overlay_circle != 0 && sit_tp_layer_on(L, uint(SIT_TP_SMPTE_BARS))) {
        vec2 res = vec2(cfg.width, cfg.height);
        vec2 px = sit_tp_px(uv, res);
#if defined(SIT_TP_USE_LAYER_SSBO)
        SitTpParamsSmpte sp = u_sit_tp_layers.smpte;
        vec4 content = sit_tp_content_area(res, sp.content_margin_x, sp.content_margin_y);
        float radius = sp.overlay_circle_radius > 0.0 ? sp.overlay_circle_radius : content.w * 0.5;
#else
        vec4 content = sit_tp_content_area(res, 0.1, 0.1);
        float radius = content.w * 0.5;
#endif
        float ring = sit_tp_ring(px, res * 0.5, radius, 2.0);
        col = sit_tp_lerp3(col, pal.bar_white, ring);
    }

    return col;
}

#endif /* SIT_TP_COMPOSE_GLSLH */
