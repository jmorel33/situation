#ifndef SIT_TP_CROSSHATCH_GLSLH
#define SIT_TP_CROSSHATCH_GLSLH

#include "sit/gpu/test_patterns/sit_tp_config.glslh"
#include "sit/gpu/test_patterns/sit_tp_colors.glslh"
#include "sit/gpu/test_patterns/sit_tp_primitives.glslh"
#include "sit/gpu/test_patterns/sit_tp_layer_params.glslh"

float sit_tp_crosshatch_line_grid(vec2 px, vec2 resolution, int nx, int ny) {
    float dx = resolution.x / float(nx);
    float dy = resolution.y / float(ny);
    float phase_x = mod(px.x + dx, dx);
    float phase_y = mod(px.y + dy, dy);
    float dist_x = min(phase_x, dx - phase_x);
    float dist_y = min(phase_y, dy - phase_y);
    float mx = 1.0 - smoothstep(0.5, 0.5 + fwidth(px.x), dist_x);
    float my = 1.0 - smoothstep(0.5, 0.5 + fwidth(px.y), dist_y);
    return clamp(max(mx, my), 0.0, 1.0);
}

vec3 sit_tp_crosshatch_on_ex(vec3 base, vec2 uv, SitTpConfig cfg, SitTpPalette pal, SitTpParamsCrosshatch p) {
    vec2 res = vec2(cfg.width, cfg.height);
    vec2 px = sit_tp_px(uv, res);
    vec3 col = base;
    float grid = sit_tp_crosshatch_line_grid(px, res, p.grid_nx, p.grid_ny);
    col = sit_tp_lerp3(col, pal.grid_white, grid);
    float cross = sit_tp_crosshair_mask(px, res * 0.5, p.crosshair_size, p.crosshair_thickness);
    col = sit_tp_lerp3(col, pal.bar_white, cross);
    return col;
}

vec3 sit_tp_crosshatch_on(vec3 base, vec2 uv, SitTpConfig cfg, SitTpPalette pal) {
#if defined(SIT_TP_USE_LAYER_SSBO)
    return sit_tp_crosshatch_on_ex(base, uv, cfg, pal, u_sit_tp_layers.crosshatch);
#else
    SitTpParamsCrosshatch p;
    p.grid_nx = 16;
    p.grid_ny = 12;
    p.crosshair_size = 20.0;
    p.crosshair_thickness = 2.0;
    p.safe_margin = 0.1;
    return sit_tp_crosshatch_on_ex(base, uv, cfg, pal, p);
#endif
}

vec3 sit_tp_crosshatch(vec2 uv, SitTpConfig cfg, SitTpPalette pal) {
    vec2 res = vec2(cfg.width, cfg.height);
    vec3 col = sit_tp_crosshatch_on(pal.bg_dark_gray, uv, cfg, pal);
#if defined(SIT_TP_USE_LAYER_SSBO)
    float safe = u_sit_tp_layers.crosshatch.safe_margin;
#else
    float safe = 0.1;
#endif
    col = sit_tp_lerp3(col, pal.bar_white, sit_tp_safe_area_border(uv, res, safe, 1.0));
    return col;
}

#endif /* SIT_TP_CROSSHATCH_GLSLH */
