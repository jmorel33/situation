#ifndef SIT_TP_PRIMITIVES_GLSLH
#define SIT_TP_PRIMITIVES_GLSLH

/* Self-contained analytic helpers — RGL calibration draw-call equivalents (§2). */

vec3 sit_tp_lerp3(vec3 a, vec3 b, float t) {
    return fma(b - a, vec3(t), a);
}

vec2 sit_tp_uv_from_px(vec2 px, vec2 resolution) {
    return px / max(resolution, vec2(1.0));
}

vec4 sit_tp_content_area(vec2 resolution, float margin_x, float margin_y) {
    return vec4(
        fma(resolution.x, margin_x, 0.0),
        fma(resolution.y, margin_y, 0.0),
        fma(resolution.x, 1.0 - 2.0 * margin_x, 0.0),
        fma(resolution.y, 1.0 - 2.0 * margin_y, 0.0));
}

float sit_tp_rect_mask(vec2 uv_px, vec4 rect_px) {
    return step(rect_px.x, uv_px.x)
         * step(rect_px.y, uv_px.y)
         * step(uv_px.x, fma(rect_px.z, 1.0, rect_px.x))
         * step(uv_px.y, fma(rect_px.w, 1.0, rect_px.y));
}

float sit_tp_rect_outline_mask(vec2 uv_px, vec4 rect_px, float thickness) {
    float inside = sit_tp_rect_mask(uv_px, rect_px);
    vec4 inner = vec4(
        fma(thickness, 1.0, rect_px.x),
        fma(thickness, 1.0, rect_px.y),
        max(fma(-2.0, thickness, rect_px.z), 0.0),
        max(fma(-2.0, thickness, rect_px.w), 0.0));
    float hole = sit_tp_rect_mask(uv_px, inner);
    return clamp(inside - hole, 0.0, 1.0);
}

float _sit_tp_dist_to_line(float coord, float spacing, float offset) {
    if (spacing <= 0.0) {
        return 1e6;
    }
    float phase = mod(fma(coord, 1.0, -offset + spacing), spacing);
    return min(phase, spacing - phase);
}

float sit_tp_grid_line(vec2 uv, vec2 resolution, vec2 spacing, vec2 offset, float thickness) {
    vec2 px = fma(uv, resolution, vec2(0.0));
    float dx = _sit_tp_dist_to_line(px.x, spacing.x, offset.x);
    float dy = _sit_tp_dist_to_line(px.y, spacing.y, offset.y);
    float half_t = max(thickness, 1.0) * 0.5;
    float mx = 1.0 - smoothstep(half_t, half_t + fwidth(px.x), dx);
    float my = 1.0 - smoothstep(half_t, half_t + fwidth(px.y), dy);
    return clamp(max(mx, my), 0.0, 1.0);
}

vec3 sit_tp_checkerboard(vec2 uv, vec2 resolution, vec4 rect_px, vec2 tile_px, vec3 c1, vec3 c2) {
    vec2 px = fma(uv, resolution, vec2(0.0));
    if (tile_px.x <= 0.0 || tile_px.y <= 0.0) {
        return c2;
    }
    if (sit_tp_rect_mask(px, rect_px) < 0.5) {
        return c2;
    }
    vec2 local = px - rect_px.xy;
    int cx = int(floor(local.x / tile_px.x));
    int cy = int(floor(local.y / tile_px.y));
    return ((cx + cy) & 1) == 0 ? c1 : c2;
}

vec3 sit_tp_stripes(vec2 uv, vec2 resolution, vec4 rect_px, float stripe_w, bool vertical, vec3 c1, vec3 c2) {
    vec2 px = fma(uv, resolution, vec2(0.0));
    if (stripe_w <= 0.0 || sit_tp_rect_mask(px, rect_px) < 0.5) {
        return c2;
    }
    vec2 local = px - rect_px.xy;
    int idx = vertical
        ? int(floor(local.x / stripe_w))
        : int(floor(local.y / stripe_w));
    return (idx & 1) == 0 ? c1 : c2;
}

float sit_tp_safe_area_border(vec2 uv, vec2 resolution, float overscan, float thickness) {
    float margin_x = fma(resolution.x, overscan, 0.0);
    float margin_y = fma(resolution.y, overscan, 0.0);
    vec4 safe = vec4(
        margin_x,
        margin_y,
        fma(-2.0, margin_x, resolution.x),
        fma(-2.0, margin_y, resolution.y));
    vec2 px = fma(uv, resolution, vec2(0.0));
    return sit_tp_rect_outline_mask(px, safe, max(thickness, 1.0));
}

float sit_tp_crosshair_mask(vec2 uv_px, vec2 center_px, float size, float thickness) {
    float half_size = size * 0.5;
    float half_t = max(thickness, 1.0) * 0.5;
    float dx = abs(uv_px.x - center_px.x);
    float dy = abs(uv_px.y - center_px.y);
    float h_line = 1.0 - smoothstep(half_t, half_t + fwidth(uv_px.y), dy);
    h_line *= 1.0 - smoothstep(half_size, half_size + fwidth(uv_px.x), dx);
    float v_line = 1.0 - smoothstep(half_t, half_t + fwidth(uv_px.x), dx);
    v_line *= 1.0 - smoothstep(half_size, half_size + fwidth(uv_px.y), dy);
    return clamp(max(h_line, v_line), 0.0, 1.0);
}

vec3 sit_tp_bilinear_gradient(vec2 uv, vec2 resolution, vec4 rect_px, vec3 tl, vec3 tr, vec3 bl, vec3 br) {
    vec2 px = fma(uv, resolution, vec2(0.0));
    if (sit_tp_rect_mask(px, rect_px) < 0.5) {
        return vec3(0.0);
    }
    vec2 local = (px - rect_px.xy) / max(rect_px.zw, vec2(1.0));
    local = clamp(local, 0.0, 1.0);
    vec3 top = sit_tp_lerp3(tl, tr, local.x);
    vec3 bot = sit_tp_lerp3(bl, br, local.x);
    return sit_tp_lerp3(bot, top, local.y);
}

float sit_tp_ring(vec2 uv_px, vec2 center, float radius, float thickness) {
    if (radius <= 0.0 || thickness <= 0.0) {
        return 0.0;
    }
    float d = length(uv_px - center);
    float inner = max(fma(-1.0, thickness, radius), 0.0);
    float fw = fwidth(d);
    float outer_mask = 1.0 - smoothstep(radius - fw, radius + fw, d);
    float inner_mask = smoothstep(inner - fw, inner + fw, d);
    return clamp(outer_mask * inner_mask, 0.0, 1.0);
}

vec3 sit_tp_blend_rect(vec3 base, vec2 px, vec4 rect_px, vec3 color) {
    return sit_tp_lerp3(base, color, sit_tp_rect_mask(px, rect_px));
}

vec3 sit_tp_blend_grid(vec3 base, vec2 uv, vec2 resolution, vec3 grid_color, float grid_alpha) {
    float spacing = max(resolution.x, 1.0) / 32.0;
    float g = sit_tp_grid_line(uv, resolution, vec2(spacing), vec2(0.0), 1.0);
    return sit_tp_lerp3(base, grid_color, g * grid_alpha);
}

float sit_tp_triangle_mask(vec2 px, vec2 p0, vec2 p1, vec2 p2) {
    vec2 e0 = p1 - p0;
    vec2 e1 = p2 - p0;
    vec2 vp = px - p0;
    float d = e0.x * e1.y - e0.y * e1.x;
    if (abs(d) < 1e-6) {
        return 0.0;
    }
    float w0 = (vp.x * e1.y - vp.y * e1.x) / d;
    float w1 = (e0.x * vp.y - e0.y * vp.x) / d;
    float w2 = 1.0 - w0 - w1;
    return step(0.0, min(min(w0, w1), w2));
}

#endif /* SIT_TP_PRIMITIVES_GLSLH */

