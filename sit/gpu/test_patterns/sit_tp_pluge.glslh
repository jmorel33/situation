#ifndef SIT_TP_PLUGE_GLSLH
#define SIT_TP_PLUGE_GLSLH

#include "sit/gpu/test_patterns/sit_tp_config.glslh"
#include "sit/gpu/test_patterns/sit_tp_colors.glslh"
#include "sit/gpu/test_patterns/sit_tp_primitives.glslh"
#include "sit/gpu/test_patterns/sit_tp_layer_params.glslh"

vec3 sit_tp_pluge_on_ex(vec3 base, vec2 uv, SitTpConfig cfg, SitTpPalette pal, SitTpParamsPluge p) {
    vec2 res = vec2(cfg.width, cfg.height);
    vec2 px = sit_tp_px(uv, res);
    vec3 col = base;
    float margin = p.safe_margin;
    vec4 content = vec4(res.x * margin, res.y * margin, res.x * (1.0 - 2.0 * margin), res.y * (1.0 - 2.0 * margin));
    int bars = max(p.bar_count, 1);
    float bar_w = content.z / float(bars);
    float bar_h = content.w * p.bar_height_frac;
    float bar_y = content.y + (content.w - bar_h) * 0.5;

    vec3 pluge_cols[4] = vec3[4](pal.pluge_minus4, pal.bar_black, pal.pluge_plus4, pal.pluge_plus75);
    for (int i = 0; i < 4; ++i) {
        float xi = content.x + float(i) * bar_w;
        col = sit_tp_blend_rect(col, px, vec4(xi, bar_y, bar_w, bar_h), pluge_cols[i]);
        float xr = content.x + float(bars - 1 - i) * bar_w;
        col = sit_tp_blend_rect(col, px, vec4(xr, bar_y, bar_w, bar_h), pluge_cols[i]);
    }

    vec3 center_cols[3] = vec3[3](pal.bar_mid_gray, pal.bar_white, pal.bar_dark_gray);
    for (int i = 0; i < 3; ++i) {
        float xi = content.x + float(4 + i) * bar_w;
        col = sit_tp_blend_rect(col, px, vec4(xi, bar_y, bar_w, bar_h), center_cols[i]);
    }
    return col;
}

vec3 sit_tp_pluge_on(vec3 base, vec2 uv, SitTpConfig cfg, SitTpPalette pal) {
#if defined(SIT_TP_USE_LAYER_SSBO)
    return sit_tp_pluge_on_ex(base, uv, cfg, pal, u_sit_tp_layers.pluge);
#else
    SitTpParamsPluge p;
    p.safe_margin = 0.1;
    p.bar_count = 10;
    p.bar_height_frac = 0.6;
    return sit_tp_pluge_on_ex(base, uv, cfg, pal, p);
#endif
}

vec3 sit_tp_pluge(vec2 uv, SitTpConfig cfg, SitTpPalette pal) {
    vec2 res = vec2(cfg.width, cfg.height);
    const float GRID_A = 100.0 / 255.0;
    vec3 col = sit_tp_pluge_on(pal.bg_dark_gray, uv, cfg, pal);
#if defined(SIT_TP_USE_LAYER_SSBO)
    float safe = u_sit_tp_layers.pluge.safe_margin;
#else
    float safe = 0.1;
#endif
    col = sit_tp_lerp3(col, pal.bar_white, sit_tp_safe_area_border(uv, res, safe, 1.0));
    col = sit_tp_blend_grid(col, uv, res, pal.grid_white, GRID_A);
    return col;
}

#endif /* SIT_TP_PLUGE_GLSLH */
