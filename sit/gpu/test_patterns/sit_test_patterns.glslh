#ifndef SIT_TEST_PATTERNS_GLSLH
#define SIT_TEST_PATTERNS_GLSLH

#include "sit/gpu/test_patterns/sit_tp_config.glslh"
#include "sit/gpu/test_patterns/sit_tp_colors.glslh"
#include "sit/gpu/test_patterns/sit_tp_primitives.glslh"
#include "sit/gpu/test_patterns/sit_tp_smpte.glslh"
#include "sit/gpu/test_patterns/sit_tp_convergence.glslh"
#include "sit/gpu/test_patterns/sit_tp_gradients.glslh"
#include "sit/gpu/test_patterns/sit_tp_pluge.glslh"
#include "sit/gpu/test_patterns/sit_tp_multiburst.glslh"
#include "sit/gpu/test_patterns/sit_tp_crosshatch.glslh"
#include "sit/gpu/test_patterns/sit_tp_cube.glslh"
#include "sit/gpu/test_patterns/sit_tp_noise.glslh"
#include "sit/gpu/test_patterns/sit_tp_compose.glslh"

vec3 sit_tp_pattern_grid_only(vec2 uv, SitTpConfig cfg, SitTpPalette pal) {
    vec2 res = vec2(cfg.width, cfg.height);
    vec3 col = pal.bg_dark_gray;
#if defined(SIT_TP_USE_LAYER_SSBO)
    SitTpParamsGrid gp = u_sit_tp_layers.grid;
#else
    SitTpParamsGrid gp;
    gp.spacing_px = 0.0;
    gp.line_alpha = 100.0 / 255.0;
    gp.line_color = vec4(pal.grid_white, 1.0);
#endif
    float spacing = gp.spacing_px > 0.0 ? gp.spacing_px : (res.x / 32.0);
    float g = sit_tp_grid_line(uv, res, vec2(spacing), vec2(0.0), 1.0);
    vec3 line = sit_tp_vec3_from_rgba(gp.line_color);
    return sit_tp_lerp3(col, line, g * gp.line_alpha);
}

vec3 sit_tp_preset_layer(vec2 uv, SitTpConfig cfg, SitTpPalette pal, uint L) {
    if (sit_tp_layer_on(L, uint(SIT_TP_SMPTE_BARS)))
        return sit_tp_smpte_bars(uv, cfg, pal);
    if (sit_tp_layer_on(L, uint(SIT_TP_CHECKERBOARD)))
        return sit_tp_pattern_checkerboard(uv, cfg, pal);
    if (sit_tp_layer_on(L, uint(SIT_TP_CONVERGENCE)))
        return sit_tp_convergence(uv, cfg, pal);
    if (sit_tp_layer_on(L, uint(SIT_TP_GRADIENTS)))
        return sit_tp_gradients(uv, cfg, pal);
    if (sit_tp_layer_on(L, uint(SIT_TP_GRID_ONLY)))
        return sit_tp_pattern_grid_only(uv, cfg, pal);
    if (sit_tp_layer_on(L, uint(SIT_TP_PLUGE)))
        return sit_tp_pluge(uv, cfg, pal);
    if (sit_tp_layer_on(L, uint(SIT_TP_CROSSHATCH)))
        return sit_tp_crosshatch(uv, cfg, pal);
    if (sit_tp_layer_on(L, uint(SIT_TP_MULTIBURST)))
        return sit_tp_multiburst(uv, cfg, pal);
    if (sit_tp_layer_on(L, uint(SIT_TP_3D_GRID)))
        return sit_tp_cube(uv, cfg, pal);
    return pal.bg_dark_gray;
}

vec3 sit_tp_sample(vec2 uv, SitTpConfig cfg, SitTpPalette pal) {
    uv = sit_tp_uv(uv);
    uint layers = uint(cfg.pattern_layers);
    uint cal = sit_tp_calibration_layers(layers);

    if (cal == 0u)
        return sit_tp_noise_rgb(uv, cfg, layers);

    if (bitCount(cal) == 1u)
        return sit_tp_preset_layer(uv, cfg, pal, cal);

    return sit_tp_compose_stack(uv, cfg, pal);
}

#endif /* SIT_TEST_PATTERNS_GLSLH */
