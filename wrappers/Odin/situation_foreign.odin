    // Check if a graphics feature is supported on current hardware.
    SituationIsFeatureSupported :: proc(feature: Situation_Render_Feature) -> b8 ---

    // Check if a file was dropped into the window this frame.
    SituationIsFileDropped :: proc() -> b8 ---

    // Check if a connected joystick has a standard gamepad mapping.
    SituationIsGamepad :: proc(jid: c.int) -> b8 ---

    // Check if a gamepad button is currently held down (a state).
    SituationIsGamepadButtonDown :: proc(jid: c.int, button: c.int) -> b8 ---

    // Check if a gamepad button was pressed down this frame (an event).
    SituationIsGamepadButtonPressed :: proc(jid: c.int, button: c.int) -> b8 ---

    // Check if a gamepad button was released this frame (an event).
    SituationIsGamepadButtonReleased :: proc(jid: c.int, button: c.int) -> b8 ---

    // Check if an image has been loaded successfully.
    SituationIsImageValid :: proc(image: Situation_Image) -> b8 ---

    // [Main thread] Check if the library has been successfully initialized.
    SituationIsInitialized :: proc() -> b8 ---

    // Check if a joystick/gamepad is connected.
    SituationIsJoystickPresent :: proc(jid: c.int) -> b8 ---

    // Check if a key is currently held down (a state).
    SituationIsKeyDown :: proc(key: c.int) -> b8 ---

    // Check if a key was pressed down this frame (an event).
    SituationIsKeyPressed :: proc(key: c.int) -> b8 ---

    // Check if a key was released this frame (an event).
    SituationIsKeyReleased :: proc(key: c.int) -> b8 ---

    // Check if a key is currently up (a state).
    SituationIsKeyUp :: proc(key: c.int) -> b8 ---

    // Check if currently in learn mode. Returns 1/0.
    SituationIsLearning :: proc(graph: ^Situation_Audio_Graph, handle: Situation_Node_Handle) -> c.int ---

    // Check if a lock key (Caps, Num) is currently active.
    SituationIsLockKeyPressed :: proc(lock_key_mod: c.int) -> b8 ---

    // Check if a node has MIDI control enabled. Returns 1/0.
    SituationIsMidiEnabled :: proc(graph: ^Situation_Audio_Graph, handle: Situation_Node_Handle) -> c.int ---

    // Check if MIDI Learn is enabled. Returns 1/0.
    SituationIsMidiLearnEnabled :: proc(graph: ^Situation_Audio_Graph, handle: Situation_Node_Handle) -> c.int ---

    // Check if a modifier key (Shift, Ctrl, Alt) is pressed.
    SituationIsModifierPressed :: proc(modifier: c.int) -> b8 ---

    // Check if a mouse button is currently held down (a state).
    SituationIsMouseButtonDown :: proc(button: c.int) -> b8 ---

    // Check if a mouse button was pressed down this frame (an event).
    SituationIsMouseButtonPressed :: proc(button: c.int) -> b8 ---

    // Check if a mouse button was released this frame.
    SituationIsMouseButtonReleased :: proc(button: c.int) -> b8 ---

    // Check if a physical key (scancode) is currently held down.
    SituationIsScancodeDown :: proc(scancode: c.int) -> b8 ---

    // Check if Scroll Lock is currently toggled on.
    SituationIsScrollLockOn :: proc() -> b8 ---

