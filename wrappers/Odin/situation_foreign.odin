    // [Main thread] Initialize the library, create window and graphics context.
    SituationInit :: proc(argc: c.int, argv: [^]cstring, init_info: ^Situation_Init_Info) -> Situation_Error ---

    // Initialize the built-in device registry (call once at startup).
    SituationInitDeviceRegistry :: proc() ---

    // Check if the application is currently paused.
    SituationIsAppPaused :: proc() -> b8 ---

    // Check if a command-line argument (e.g., "-server") was provided.
    SituationIsArgumentPresent :: proc(arg_name: cstring) -> b8 ---

    // Check if the audio device is currently playing.
    SituationIsAudioDevicePlaying :: proc() -> b8 ---

    // Check if a device type is registered.
