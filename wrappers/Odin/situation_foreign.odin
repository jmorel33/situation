    SituationSetScreenshotFormat :: proc(format: Situation_Screenshot_Format) ---

    // Set a callback for mouse scroll events.
    SituationSetScrollCallback :: proc(callback: Situation_Scroll_Callback, user_data: rawptr) ---

    // [OpenGL] Set a standalone uniform by name (location cache). While a frame is active, defers to SIT_OP_SET_UNIFORM.
    SituationSetShaderUniform :: proc(shader: Situation_Shader, uniform_name: cstring, data: rawptr, type: Situation_Uniform_Type) -> Situation_Error ---

    // [OpenGL] Set float uniform array.
    SituationSetShaderUniform1fv :: proc(shader: Situation_Shader, uniform_name: cstring, count: c.int, values: ^f32) -> Situation_Error ---

    // [OpenGL] Set int uniform array in one call (e.g. name "uWallRows[0]", count=24). While a frame is active, records SIT_OP_SET_UNIFORM (same as render-thread mode).
    SituationSetShaderUniform1iv :: proc(shader: Situation_Shader, uniform_name: cstring, count: c.int, values: ^c.int) -> Situation_Error ---

    // [OpenGL] Set uniform by explicit location (SPIR-V layout(location=)); defers during frames like SituationSetShaderUniform.
    SituationSetShaderUniformLocation :: proc(shader: Situation_Shader, location: c.int, data: rawptr, type: Situation_Uniform_Type) -> Situation_Error ---

    // [OpenGL] Set mat4 uniform array.
    SituationSetShaderUniformMatrix4fv :: proc(shader: Situation_Shader, uniform_name: cstring, count: c.int, matrices: ^mat4) -> Situation_Error ---

    // Apply an echo effect to a sound.
    SituationSetSoundEcho :: proc(sound: ^Situation_Sound, enabled: b8, delay_sec: f32, feedback: f32, wet_mix: f32) -> Situation_Error ---

    // Apply a low-pass or high-pass filter to a sound.
    SituationSetSoundFilter :: proc(sound: ^Situation_Sound, type: Situation_Filter_Type, cutoff_hz: f32, q_factor: f32) -> Situation_Error ---

    // Set the stereo pan for a sound [-1.0 to 1.0].
    SituationSetSoundPan :: proc(sound: ^Situation_Sound, pan: f32) -> Situation_Error ---

    // Set the pitch for a sound (resamples).
    SituationSetSoundPitch :: proc(sound: ^Situation_Sound, pitch: f32) -> Situation_Error ---

    // Apply a reverb effect to a sound.
    SituationSetSoundReverb :: proc(sound: ^Situation_Sound, enabled: b8, room_size: f32, damping: f32, wet_mix: f32, dry_mix: f32) -> Situation_Error ---

    // Set the volume for a specific sound.
    SituationSetSoundVolume :: proc(sound: ^Situation_Sound, volume: f32) -> Situation_Error ---

    // Set a desired frame rate cap (0 for uncapped).
    SituationSetTargetFPS :: proc(fps: c.int) ---

    // [Phase 2] Update sampler state.
    SituationSetTextureSamplerParams :: proc(texture: Situation_Texture, min_filter: Situation_Texture_Filter, mag_filter: Situation_Texture_Filter, wrap_s: Situation_Texture_Wrap, wrap_t: Situation_Texture_Wrap) -> Situation_Error ---

    // Pins the CURRENT thread (logical CPU bitmask, bits 0..63)
    SituationSetThreadAffinity :: proc(core_mask: u64) -> Situation_Error ---

    // Set affinity; optional previous mask
    SituationSetThreadAffinityEx :: proc(core_mask: u64, out_previous: ^u64) -> Situation_Error ---

    // Set the period of an oscillator.
    SituationSetTimerOscillatorPeriod :: proc(oscillator_id: c.int, period_seconds: f64) -> Situation_Error ---

    // Route a procedural tone to the active graph's SFX sound source.
    SituationSetToneRouting :: proc(handle: Situation_Tone_Handle, route_to_graph: b8) -> Situation_Error ---

    // Set the minimum log level for output filtering.
    SituationSetTraceLogLevel :: proc(logType: c.int) ---

    // Enable or disable VSync (vertical synchronization).
    SituationSetVSync :: proc(enable: b8) ---

    // Tier B storage-only attachment defaults.
    SituationSetVirtualDisplayAttachmentDefaults :: proc(display_id: c.int, defaults: ^Situation_Virtual_Display_Attachment_Defaults) -> Situation_Error ---

    // Mark a virtual display as needing to be re-rendered.
    SituationSetVirtualDisplayDirty :: proc(display_id: c.int, is_dirty: b8) ---

    // SOLID idle tint (normalized by compositor).
    SituationSetVirtualDisplayFallbackColor :: proc(display_id: c.int, color: Color_RGBA) ---

    // SOLID, COLORBURST, or PATTERN when idle.
    SituationSetVirtualDisplayFallbackMode :: proc(display_id: c.int, mode: Situation_VD_Fallback_Mode) ---

    // Set idle threshold for compositor fallback (Phase 2a).
    SituationSetVirtualDisplayIdleThreshold :: proc(display_id: c.int, threshold_seconds: f64) ---

    // Full standby tuning + PATTERN mode.
    SituationSetVirtualDisplayPatternConfig :: proc(display_id: c.int, config: ^Sit_Vd_Standby_Config) ---

    // Toggle bitmask + PATTERN fallback (plan §3.4).
    SituationSetVirtualDisplayPatternLayers :: proc(display_id: c.int, pattern_layers: c.int) ---

    // Set the scaling/filtering mode for a virtual display.
    SituationSetVirtualDisplayScalingMode :: proc(display_id: c.int, scaling_mode: Situation_Scaling_Mode) -> Situation_Error ---

    // Set the window to be focused.
    SituationSetWindowFocused :: proc() ---

    // Set the icon for the window (single image).
    SituationSetWindowIcon :: proc(image: Situation_Image) ---

    // Set the icon for the window (multiple sizes).
    SituationSetWindowIcons :: proc(count: c.int) ---

    // Set the window maximum dimensions.
    SituationSetWindowMaxSize :: proc(width: c.int, height: c.int) ---

    // Set the window minimum dimensions.
    SituationSetWindowMinSize :: proc(width: c.int, height: c.int) ---

    // Set the window to be fullscreen on a specific monitor.
    SituationSetWindowMonitor :: proc(monitor_id: c.int) ---

    // Set window opacity [0.0f to 1.0f].
    SituationSetWindowOpacity :: proc(opacity: f32) ---

    // Set the window position on the screen.
    SituationSetWindowPosition :: proc(x: c.int, y: c.int) ---

    // Set the window dimensions.
    SituationSetWindowSize :: proc(width: c.int, height: c.int) ---

    // Set window configuration state using flags (additive).
    SituationSetWindowState :: proc(flags: u32) ---

    // Set the flag profiles for when the window is focused vs. unfocused.
    SituationSetWindowStateProfiles :: proc(active_flags: u32, inactive_flags: u32) -> Situation_Error ---

    // Set the title for the window.
    SituationSetWindowTitle :: proc() ---

    // Create connected virtual out→in pair. Returns input device_id for SituationEnableMidiControl().
    SituationSetupVirtualMidiLoopback :: proc(out_input_device_id: ^c.int) -> Situation_Error ---

    // Show the mouse cursor.
    SituationShowCursor :: proc() ---

    // Blocking UI message box; for fatal init errors.
    SituationShowMessageBox :: proc(title: cstring, message: cstring) ---

    // [Main thread] Shut down the library and release all resources.
    SituationShutdown :: proc() ---

    // Create a new sound by copying the raw PCM data from a source.
    SituationSoundCopy :: proc(source: ^Situation_Sound, out_destination: ^Situation_Sound) -> Situation_Error ---

    // Crop a sound's PCM data in-place to a new range.
    SituationSoundCrop :: proc(sound: ^Situation_Sound, initFrame: u64, finalFrame: u64) -> Situation_Error ---

    // Export the sound's raw PCM data to a WAV file.
    SituationSoundExportAsWav :: proc(sound: ^Situation_Sound, fileName: cstring) -> Situation_Error ---

    // Start capturing audio input with default format.
    SituationStartAudioCapture :: proc(callback: Situation_Audio_Capture_Callback, user_data: rawptr) -> Situation_Error ---

    // Start capturing with explicit sample rate and channel count.
    SituationStartAudioCaptureEx :: proc(callback: Situation_Audio_Capture_Callback, user_data: rawptr, sample_rate: u32, channels: u32) -> Situation_Error ---

    // Start learning: next CC received maps to this param. Scaling: 0=linear, 1=log, 2=dB, 3=discrete. Times out after 5s.
    SituationStartMidiLearn :: proc(graph: ^Situation_Audio_Graph, handle: Situation_Node_Handle, control_index: c.int, param_name: cstring, min_value: f32, max_value: f32, scaling: c.int) -> Situation_Error ---

    // Stop all currently playing sounds.
    SituationStopAllLoadedSounds :: proc() -> Situation_Error ---

    // Stop all active tones (triggers release on each).
    SituationStopAllTones :: proc() ---

    // Stop audio capture and release the input device.
    SituationStopAudioCapture :: proc() ---

    // Stop a specific sound from playing.
    SituationStopLoadedSound :: proc(sound: ^Situation_Sound) -> Situation_Error ---

    // Gracefully stop a tone by triggering its release envelope. Invalid handles are ignored.
    SituationStopTone :: proc(handle: Situation_Tone_Handle) ---

    // Submits a job with priority flags and optional data payload.
    SituationSubmitJobEx :: proc(pool: ^Situation_Thread_Pool, data: rawptr, data_size: uint, flags: Situation_Job_Flags) -> Situation_Job_Id ---

    // Submit a render list for async recording on a worker thread.
    SituationSubmitRenderList :: proc(pool: ^Situation_Thread_Pool, list: Situation_Render_List, user_data: rawptr) -> Situation_Job_Id ---

    // Take a screenshot. fileName is the base name (no extension) or NULL for auto-name. Extension added from format setting.
    SituationTakeScreenshot :: proc() -> Situation_Error ---

    // Close and destroy the virtual loopback devices.
    SituationTeardownVirtualMidiLoopback :: proc() ---

    // Get the period of an oscillator in seconds.
    SituationTimerGetOscillatorPeriod :: proc(oscillator_id: c.int) -> f64 ---

    // Get the current binary state (0 or 1) of an oscillator.
    SituationTimerGetOscillatorState :: proc(oscillator_id: c.int) -> b8 ---

    // Get the total number of times an oscillator has triggered.
    SituationTimerGetOscillatorTriggerCount :: proc(oscillator_id: c.int) -> u64 ---

    // Get progress [0.0 to 1.0+] of the interval since the last successful ping.
    SituationTimerGetPingProgress :: proc(oscillator_id: c.int) -> f64 ---

    // Get the previous frame's state of an oscillator.
    SituationTimerGetPreviousOscillatorState :: proc(oscillator_id: c.int) -> b8 ---

    // Get the total time elapsed since initialization.
    SituationTimerGetTime :: proc() -> f64 ---

    // Check if an oscillator's state has changed this frame.
    SituationTimerHasOscillatorUpdated :: proc(oscillator_id: c.int) -> b8 ---

    // Check if an oscillator's period has elapsed since the last ping.
    SituationTimerPingOscillator :: proc(oscillator_id: c.int) -> b8 ---

    // Toggle window between borderless and decorated mode.
    SituationToggleBorderlessWindowed :: proc() ---

    // Toggle window between fullscreen and windowed mode.
    SituationToggleFullscreen :: proc() ---

    // Toggle flags in the current profile and apply the result.
    SituationToggleWindowStateFlags :: proc(flags_to_toggle: Situation_Window_State_Flags) -> Situation_Error ---

    // Re-sort the graph processing order after topology changes. Call from the main thread after CreateNode/DestroyNode/CreatePatch/RemovePatch.
    SituationTopologicalSort :: proc(graph: ^Situation_Audio_Graph) -> Situation_Error ---

    // Unload audio by handle and free resources.
    SituationUnloadAudio :: proc(handle: Situation_Sound_Handle) ---

    // Unload the file path list returned by SituationLoadDroppedFiles.
    SituationUnloadDroppedFiles :: proc(paths: [^]cstring, count: c.int) ---

    // Frees CPU font data, glyph metrics, and owned GPU atlas (not the built-in default).
    SituationUnloadFont :: proc(font: Situation_Font) ---

    // Unload an image's pixel data from memory.
    SituationUnloadImage :: proc(image: Situation_Image) ---

    // Frees all GPU and CPU resources associated with a loaded model.
    SituationUnloadModel :: proc(model: ^Situation_Model) ---

    // Unload a graphics shader pipeline and free its GPU resources.
    SituationUnloadShader :: proc(shader: ^Situation_Shader) ---

    // Unload a sound and free its resources.
    SituationUnloadSound :: proc(sound: ^Situation_Sound) ---

    SituationUpdate :: proc() ---
    // Update data in a GPU buffer.
    SituationUpdateBuffer :: proc(buffer: Situation_Buffer, offset: uint, size: uint, data: rawptr) -> Situation_Error ---

    // [Main thread] Update all internal timers (frame timer, temporal system). Call after polling events.
    SituationUpdateTimers :: proc() ---

    // Returns first missing/wrong-type uniform, or SUCCESS if all resolved.
    SituationValidateShaderUniforms :: proc(shader: Situation_Shader, table: ^Situation_Uniform_Expectation, table_count: c.int, error_buf: cstring, error_buf_size: uint) -> Situation_Error ---

    // CC (e.g. mod wheel, expression).
    SituationVirtualMidiControlChange :: proc(channel: u8, controller: u8, value: u8) -> Situation_Error ---

    // Inject note-off on channel 0 (legacy wrapper).
    SituationVirtualMidiNoteOff :: proc(note: u8) -> Situation_Error ---

    // Channel-aware note-off (0-15).
    SituationVirtualMidiNoteOffEx :: proc(channel: u8, note: u8) -> Situation_Error ---

    // Inject note-on on channel 0 (legacy wrapper).
    SituationVirtualMidiNoteOn :: proc(note: u8, velocity: u8) -> Situation_Error ---

    // Channel-aware note-on (0-15).
    SituationVirtualMidiNoteOnEx :: proc(channel: u8, note: u8, velocity: u8) -> Situation_Error ---

    // Pitch bend 0..16383 (center 8192).
    SituationVirtualMidiPitchBend :: proc(channel: u8, bend: i16) -> Situation_Error ---

    // Program change on channel 0-15.
    SituationVirtualMidiProgramChange :: proc(channel: u8, program: u8) -> Situation_Error ---

    // Blocks until all queued jobs are finished.
    SituationWaitForAllJobs :: proc(pool: ^Situation_Thread_Pool) ---

    // Waits for a specific job to complete (O(1) check).
    SituationWaitForJob :: proc(pool: ^Situation_Thread_Pool, job_id: Situation_Job_Id) -> Situation_Error ---

    // Check if the application should close (e.g., user clicked X).
    SituationWindowShouldClose :: proc() -> b8 ---

    // Scale Q (chroma amplitude); preserve luma and phase.
    SituationYpqAdjustChroma :: proc(color: Color_YPQA, chroma_factor: f32) -> Color_YPQA ---

    // Scale Y (luma); preserve phase and chroma.
    SituationYpqAdjustLuma :: proc(color: Color_YPQA, luma_factor: f32) -> Color_YPQA ---

    // Rotate hue; P shifts by byte steps mod 256.
    SituationYpqAdjustPhase :: proc(color: Color_YPQA, phase_shift: c.int) -> Color_YPQA ---

    SituationYpqAnalyzeRgbMapping :: proc(out: ^Situation_Ypq_Rgb_Mapping_Stats) -> Situation_Error ---
    // Reduce chroma if linear RGB would clip.
    SituationYpqClampInGamut :: proc(ypq: Color_YP_Qf) -> Color_YP_Qf ---

    // Weighted distance in YPQ space.
    SituationYpqDistance :: proc(a: Color_YPQA, b: Color_YPQA) -> f32 ---

    // Per-channel tolerance compare.
    SituationYpqEquals :: proc(a: Color_YPQA, b: Color_YPQA, tolerance: u8) -> b8 ---

    // Normalized chroma amplitude [0, 1].
    SituationYpqGetChroma :: proc(color: Color_YPQA) -> f32 ---

    // Hue in degrees [0, 360).
    SituationYpqGetHueDegrees :: proc(color: Color_YPQA) -> f32 ---

    // Normalized luma [0, 1].
    SituationYpqGetLuma :: proc(color: Color_YPQA) -> f32 ---

    // Interpolate YPQ; phase uses shortest arc on the hue wheel.
    SituationYpqLerp :: proc(a: Color_YPQA, b: Color_YPQA, t: f32) -> Color_YPQA ---

    // Float YPQ → 8-bit ColorYPQA.
    SituationYpqQuantize :: proc(ypq: Color_YP_Qf) -> Color_YPQA ---

    SituationYpqSliceDuplicateCount :: proc(axis: c.char, value: c.int, out_dup: ^c.int) -> Situation_Error ---
    // Float YPQ → A2R10G10B10 packed pixel (10-bit SDR).
    SituationYpqToRgb10Packed :: proc(ypq: Color_YP_Qf) -> u32 ---

    // Float YPQ → PQ-encoded A2R10G10B10 (HDR10 swapchain).
    SituationYpqToRgb10PackedHdr :: proc(ypq: Color_YP_Qf) -> u32 ---

    // Float YPQ → 10-bit RGBA (linear YIQ, clamped).
    SituationYpqToRgba10 :: proc(ypq: Color_YP_Qf) -> Color_RGBA10 ---

}
