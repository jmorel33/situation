PROCEDURE SituationSerializeGraphToJSON (graph: SituationAudioGraph) : ADDRESS;

(* Set the active audio processing graph (replaces default). NULL disables graph processing. *)
PROCEDURE SituationSetActiveGraph (graph: SituationAudioGraph) : SituationError;

