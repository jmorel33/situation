(* Mid-pass clear of the active color attachment. *)
PROCEDURE SituationCmdClearColor (cmd: SituationCommandBuffer; color: ColorRGBA) : SituationError;

(* Mid-pass clear of the active depth attachment. *)
PROCEDURE SituationCmdClearDepth (cmd: SituationCommandBuffer; depth: REAL) : SituationError;

(* Mid-pass clear of active depth and stencil attachments. *)
PROCEDURE SituationCmdClearDepthStencil (cmd: SituationCommandBuffer; depth: REAL; stencil: CARDINAL) : SituationError;

(* Mid-pass clear of the active stencil attachment when supported by backend/attachment state. *)
