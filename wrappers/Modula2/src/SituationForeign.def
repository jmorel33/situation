(* Load an entire file into a memory buffer (caller must free). *)
PROCEDURE SituationLoadFileData (file_path: ADDRESS; out_bytes_read: CARDINALPtr; out_data: CARDINAL8Ptr) : SituationError;

(* Load a text file into a null-terminated string (caller must free). *)
PROCEDURE SituationLoadFileText (file_path: ADDRESS) : ADDRESS;

(* Asynchronously load a text file. *)
PROCEDURE SituationLoadFileTextAsync (pool: SituationThreadPool; file_path: ADDRESS; callback: SituationFileTextLoadCallback; user_data: ADDRESS) : SituationJobId;

(* Load a font from a TTF/OTF file for CPU rendering. *)
PROCEDURE SituationLoadFont (out_font: SituationFontPtr) : SituationError;

(* Loads a font directly from a memory buffer (e.g., embedded resource). *)
PROCEDURE SituationLoadFontFromMemory (data: ADDRESS; dataSize: INTEGER; out_font: SituationFontPtr) : SituationError;

(* Load a graph from a JSON file, re-creating nodes via device_funcs. *)
PROCEDURE SituationLoadGraphFromFile (graph: SituationAudioGraph; filepath: ADDRESS; device_funcs: SituationDeviceFunctions; num_device_funcs: INTEGER) : SituationError;

(* Load an image via stb_image (JPEG, PNG, BMP, TGA, PSD, GIF, HDR, PIC, PNM). *)
PROCEDURE SituationLoadImage (out_image: SituationImage) : SituationError;

(* Load an image from a memory buffer. *)
PROCEDURE SituationLoadImageFromMemory (dataSize: INTEGER; out_image: SituationImage) : SituationError;

(* Get a copy of the current screen backbuffer as an image. *)
PROCEDURE SituationLoadImageFromScreen (out_image: SituationImage) : SituationError;

(* Load MIDI Learn mappings from JSON file. *)
PROCEDURE SituationLoadMidiPreset (graph: SituationAudioGraph; handle: SituationNodeHandle; filename: ADDRESS) : SituationError;

(* Loads a complete 3D model and its textures from a GLTF file. *)
PROCEDURE SituationLoadModel (file_path: ADDRESS; out_model: SituationModel) : SituationError;

(* Wavefront OBJ: triangulated meshes, MTL/textures; missing/degenerate normals filled from face geometry, authored normals preserved. *)
PROCEDURE SituationLoadModelFromOBJ (file_path: ADDRESS; out_model: SituationModel) : SituationError;

(* Loads a 3D model from a binary or ASCII STL file. UVs are zeroed; normals are flat (per-face) by default, or smooth (averaged per shared vertex) when smooth_normals is true. *)
PROCEDURE SituationLoadModelFromSTL (file_path: ADDRESS; smooth_normals: BOOLEAN; out_model: SituationModel) : SituationError;

(* Load a graphics shader pipeline from vertex and fragment files. *)
PROCEDURE SituationLoadShader (vs_path: ADDRESS; fs_path: ADDRESS; out_shader: SituationShaderPtr) : SituationError;

(* Create a graphics shader pipeline from in-memory GLSL source. *)
PROCEDURE SituationLoadShaderFromMemory (vs_code: ADDRESS; fs_code: ADDRESS; out_shader: SituationShaderPtr) : SituationError;

(* Precompiled .spv: OpenGL via GL_ARB_gl_spirv; Vulkan same pipeline contract as SituationLoadShaderFromMemory (no shaderc required). *)
PROCEDURE SituationLoadShaderFromSpirv (vs_spv_path: ADDRESS; fs_spv_path: ADDRESS; out_shader: SituationShaderPtr) : SituationError;

(* Same as SituationLoadShaderFromSpirv but from in-memory SPIR-V (e.g. build-time embedded .spv). No hot-reload paths (vs/fs file paths left unset). *)
PROCEDURE SituationLoadShaderFromSpirvMemory (vs_spirv: ADDRESS; vs_len: ADDRESS; fs_spirv: ADDRESS; fs_len: ADDRESS; out_shader: SituationShaderPtr) : SituationError;

(* [Vulkan] `layout_profile` selects user SSBO/UBO layouts; [OpenGL] profile ignored. *)
PROCEDURE SituationLoadShaderFromSpirvMemoryEx (vs_spirv: ADDRESS; vs_len: ADDRESS; fs_spirv: ADDRESS; fs_len: ADDRESS; layout_profile: SituationSpirvLayoutProfile; out_shader: SituationShaderPtr) : SituationError;

(* Load a sound from a file. *)
PROCEDURE SituationLoadSoundFromFile (file_path: ADDRESS; mode: SituationAudioLoadMode; looping: BOOLEAN; out_sound: SituationSoundPtr) : SituationError;

(* Asynchronously loads and decodes a sound file. *)
PROCEDURE SituationLoadSoundFromFileAsync (pool: SituationThreadPool; file_path: ADDRESS; looping: BOOLEAN; out_sound: SituationSoundPtr) : SituationJobId;

(* Load a sound from a custom stream. *)
PROCEDURE SituationLoadSoundFromStream (on_read: SituationStreamReadCallback; on_seek: SituationStreamSeekCallback; user_data: ADDRESS; format: SituationAudioFormat; looping: BOOLEAN; out_sound: SituationSoundPtr) : SituationError;

(* Loads a texture from disk and registers the path for hot-reloading. *)
PROCEDURE SituationLoadTexture (file_path: ADDRESS; generate_mipmaps: BOOLEAN; out_texture: SituationTexturePtr) : SituationError;

(* Maximize the window if it's resizable. *)
PROCEDURE SituationMaximizeWindow ();

(* Measure the pixel dimensions of a string before drawing. *)
PROCEDURE SituationMeasureText (font: SituationFont; fontSize: REAL) : SitRectangle;

(* Measure with extra per-character spacing. *)
PROCEDURE SituationMeasureTextEx (font: SituationFont; fontSize: REAL; spacing: REAL) : SitRectangle;

PROCEDURE SituationMemoryBarrier (cmd: SituationCommandBuffer; barrier_bits: CARDINAL);
(* Minimize the window (iconify). *)
PROCEDURE SituationMinimizeWindow ();

(* Move/rename a file, even across drives on Windows. *)
PROCEDURE SituationMoveFile (old_path: ADDRESS; new_path: ADDRESS) : SituationError;

(* Open a file or folder with its default application. *)
PROCEDURE SituationOpenFile (filePath: ADDRESS);

(* Pause the application's internal state (e.g., audio). *)
PROCEDURE SituationPauseApp ();

(* Pause audio playback on the device. *)
PROCEDURE SituationPauseAudioDevice () : SituationError;

(* Peek at the next key in the press queue without consuming it. *)
PROCEDURE SituationPeekKeyPressed () : INTEGER;

(* Peek at the next key and its scancode. *)
PROCEDURE SituationPeekKeyPressedEx (out_scancode: INTEGERPtr) : INTEGER;

(* Play audio by handle (restarts if already playing). *)
PROCEDURE SituationPlayAudio (handle: SituationSoundHandle) : SituationError;

(* Play a loaded sound (restarts if already playing). *)
PROCEDURE SituationPlayLoadedSound (sound: SituationSoundPtr) : SituationError;

(* Legacy: play a tone by MIDI note number (0-127). *)
PROCEDURE SituationPlayMidiNote (note: INTEGER; type: SituationWaveType; volume: REAL; attack_sec: REAL; decay_sec: REAL; sustain_level: REAL; release_sec: REAL; hold_sec: REAL);

(* Legacy: play a simple ADSR tone (backward compat / quick UI sounds). *)
PROCEDURE SituationPlayTone (type: SituationWaveType; frequency: REAL; volume: REAL; attack_sec: REAL; decay_sec: REAL; sustain_level: REAL; release_sec: REAL; hold_sec: REAL);

(* @brief Plays an extended procedural tone with full control. @param type          Waveform type (Sine, Square, Triangle, Saw, Noise) @param frequency     Frequency in Hz (e.g., 440.0f). For noise: ignored (use 0.0f) @param volume        Peak volume (0.0 to 1.0) @param pan           Stereo panning (-1.0 left, 0.0 center, +1.0 right) @param attack_sec    Attack time in seconds @param decay_sec     Decay time in seconds @param sustain_level Sustain volume level (0.0 to 1.0) @param release_sec   Release time in seconds @param hold_sec      Hold duration in seconds. Use -1.0f for infinite sustain (key down) @return Handle to the playing tone, or 0 if no voice available (polyphony limit) *)
PROCEDURE SituationPlayToneEx (type: SituationWaveType; frequency: REAL; volume: REAL; pan: REAL; attack_sec: REAL; decay_sec: REAL; sustain_level: REAL; release_sec: REAL; hold_sec: REAL) : SituationToneHandle;

(* [Main thread] Poll for all input events (keyboard, mouse, joystick). Call once per frame. *)
PROCEDURE SituationPollInputEvents ();

(* SITUATION_SUCCESS when ready, SITUATION_ERROR_SHADER_LOAD_IN_PROGRESS while compiling/linking/building pipelines. *)
PROCEDURE SituationPollShaderLoad (shader: SituationShader) : SituationError;

(* Uniform PQ gray → A2R10G10B10 packed pixel. *)
PROCEDURE SituationPqGrayToRgb10Packed (pq_level: REAL) : CARDINAL;

(* ST.2084 PQ [0,1] → linear display light [0,1]. *)
PROCEDURE SituationPqToLinear (pq: REAL) : REAL;

(* Human-readable threading status (stdout if NULL) *)
PROCEDURE SituationPrintThreadingStatus (out_stream: FILEPtr);

(* Push interleaved float PCM into a PCM_INPUT node's ring buffer (any thread). Returns frames written. *)
PROCEDURE SituationPushNodePCM (graph: SituationAudioGraph; node: SituationNodeHandle; samples: REALPtr; frame_count: CARDINAL; channels: CARDINAL) : CARDINAL;

(* [OpenGL] Enumerate all active SSBO blocks and their assigned binding points. out_count receives actual block count (may exceed capacity). Returns NOT_IMPLEMENTED on Vulkan. *)
PROCEDURE SituationQueryShaderStorageBlocks (shader: SituationShader; out_blocks: SituationShaderStorageBlockInfo; capacity: INTEGER; out_count: INTEGERPtr) : SituationError;

(* Read mapped buffer data safely. *)
PROCEDURE SituationReadBuffer (readback_buf: SituationBuffer; dst: ADDRESS; size: ADDRESS) : SituationError;

(* [Phase 2] Blocking readback of framebuffer pixels (RGBA8 or raw RGB10 packed). *)
PROCEDURE SituationReadFramebuffer (desc: SituationReadPixelsDesc; dst_pixels: ADDRESS; dst_size_bytes: ADDRESS) : SituationError;

(* [Phase 8] Raw A2R10G10B10 readback when HDR10 swapchain active. *)
PROCEDURE SituationReadFramebufferHdr (desc: SituationReadPixelsDesc; dst_pixels: CARDINALPtr; dst_size_bytes: ADDRESS) : SituationError;

(* [Phase 2] Blocking readback of texture pixels. *)
PROCEDURE SituationReadTexture (texture: SituationTexture; desc: SituationTextureReadbackDesc; dst_pixels: ADDRESS; dst_size_bytes: ADDRESS) : SituationError;

(* [Phase 2] Blocking readback into allocated SituationImage. *)
PROCEDURE SituationReadTextureAlloc (texture: SituationTexture; desc: SituationTextureReadbackDesc; out_image: SituationImage) : SituationError;

(* Rebuilds the process-wide topology cache *)
PROCEDURE SituationRefreshCpuTopology () : SituationError;

(* Force a refresh of the cached display information. *)
PROCEDURE SituationRefreshDisplays ();

(* Rebuild NUMA summary from CPU topology + OS memory *)
PROCEDURE SituationRefreshNumaTopology () : SituationError;

(* Register a custom device type with the registry. *)
PROCEDURE SituationRegisterDeviceType (meta: SituationDeviceMetadata) : SituationError;

(* Recompiles a compute pipeline from its original source file (Synchronous/Stalls GPU). *)
PROCEDURE SituationReloadComputePipeline (pipeline: SituationComputePipelinePtr) : SituationError;

(* Re-parses GLTF/GLB file and rebuilds all meshes and textures (Synchronous/Stalls GPU). *)
PROCEDURE SituationReloadModel (model: SituationModel) : SituationError;

(* Recompiles and links a shader from its original source files (Synchronous/Stalls GPU). *)
PROCEDURE SituationReloadShader (shader: SituationShaderPtr) : SituationError;

(* Re-reads image file and recreates the GPU texture resource (Synchronous/Stalls GPU). *)
PROCEDURE SituationReloadTexture (texture: SituationTexturePtr) : SituationError;

(* Disconnect a specific patch between two ports. *)
PROCEDURE SituationRemovePatch (graph: SituationAudioGraph; src: SituationNodeHandle; src_port: INTEGER; dst: SituationNodeHandle; dst_port: INTEGER; is_control: BOOLEAN) : SituationError;

(* Alias for SituationMoveFile. *)
PROCEDURE SituationRenameFile (old_path: ADDRESS; new_path: ADDRESS) : SituationError;

(* Fill pass struct from VD attachment defaults (tier C helper). *)
PROCEDURE SituationRenderPassInfoInherit (display_id: INTEGER) : SituationRenderPassInfo;

(* Composite all visible virtual displays to the current target. *)
PROCEDURE SituationRenderVirtualDisplays (cmd: SituationCommandBuffer) : SituationError;

(* Replay a previously recorded render list into a command buffer. *)
PROCEDURE SituationReplayRenderList (cmd: SituationCommandBuffer; list: SituationRenderList);

PROCEDURE SituationRequestScreenCapture ();
(* Reset a render list for reuse next frame. *)
PROCEDURE SituationResetRenderList (list: SituationRenderList);

(* Zero scheduler counters *)
PROCEDURE SituationResetThreadPoolStats (pool: SituationThreadPool);

(* Restore a minimized or maximized window. *)
PROCEDURE SituationRestoreWindow ();

(* Resume a paused application. *)
PROCEDURE SituationResumeApp ();

(* Resume audio playback on the device. *)
PROCEDURE SituationResumeAudioDevice () : SituationError;

(* Upscale 8-bit RGBA → 10-bit. *)
PROCEDURE SituationRgb10FromRgba (color: ColorRGBA) : ColorRGBA10;

(* Converts a standard RGBA color to the Hue, Saturation, Value color space. *)
PROCEDURE SituationRgbToHsv (rgb: ColorRGBA) : ColorHSV;

(* 10-bit RGBA → float YPQ. *)
PROCEDURE SituationRgbToYpqFrom10 (color: ColorRGBA10) : ColorYPQf;

(* Downscale 10-bit RGBA → 8-bit. *)
PROCEDURE SituationRgbaFromRgb10 (color: ColorRGBA10) : ColorRGBA;

(* A2R10G10B10 texel → RGBA8 (readback parity). *)
PROCEDURE SituationRgbaFromRgb10Packed (packed: CARDINAL) : ColorRGBA;

(* Asynchronously save a file. *)
PROCEDURE SituationSaveFileAsync (pool: SituationThreadPool; file_path: ADDRESS; data: ADDRESS; size: ADDRESS; callback: SituationFileSaveCallback; user_data: ADDRESS) : SituationJobId;

(* Save a block of memory to a file. *)
PROCEDURE SituationSaveFileData (file_path: ADDRESS; data: ADDRESS; bytes_to_write: CARDINAL) : SituationError;

(* Save a null-terminated string to a text file. *)
PROCEDURE SituationSaveFileText (file_path: ADDRESS; text: ADDRESS) : SituationError;

(* Asynchronously save a text file. *)
PROCEDURE SituationSaveFileTextAsync (pool: SituationThreadPool; file_path: ADDRESS; text: ADDRESS; callback: SituationFileSaveCallback; user_data: ADDRESS) : SituationJobId;

(* Save a graph to a JSON file. *)
