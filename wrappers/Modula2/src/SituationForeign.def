PROCEDURE SituationSetAudioDevice (internal_id: INTEGER; format: SituationAudioFormat) : SituationError;

(* Set the master volume for the audio device. *)
PROCEDURE SituationSetAudioMasterVolume (volume: REAL) : SituationError;

(* Set a callback to receive mixed output samples (for VU meters, FFT, etc.). *)
PROCEDURE SituationSetAudioOutputMonitor (user_data: ADDRESS);

(* Set stereo pan for a handle-based sound [-1.0 to 1.0]. *)
PROCEDURE SituationSetAudioPan (handle: SituationSoundHandle; pan: REAL) : SituationError;

(* Set pitch multiplier for a handle-based sound (1.0 = normal). *)
PROCEDURE SituationSetAudioPitch (handle: SituationSoundHandle; pitch: REAL) : SituationError;

(* Re-initialize the audio device with a new sample rate. *)
PROCEDURE SituationSetAudioPlaybackSampleRate (sample_rate: INTEGER) : SituationError;

(* Set volume for a handle-based sound [0.0 to 1.0+]. *)
PROCEDURE SituationSetAudioVolume (handle: SituationSoundHandle; volume: REAL) : SituationError;

(* Set text in the system clipboard. *)
PROCEDURE SituationSetClipboardText (text: ADDRESS) : SituationError;

(* Set a control parameter on a node. *)
PROCEDURE SituationSetControl (graph: SituationAudioGraph; handle: SituationNodeHandle; control_id: CARDINAL; value: REAL) : SituationError;

(* OS-visible name for the calling thread (UTF-8); no-op if NULL/empty *)
PROCEDURE SituationSetCurrentThreadName (name: ADDRESS);

(* Set the mouse cursor to a standard shape. *)
PROCEDURE SituationSetCursor (cursor: SituationCursor);

(* Set a callback for mouse movement events. *)
PROCEDURE SituationSetCursorPosCallback (callback: SituationCursorPosCallback; user_data: ADDRESS);

(* Set the display mode for a monitor. *)
PROCEDURE SituationSetDisplayMode (monitor_id: INTEGER; mode: SituationDisplayMode; fullscreen: BOOLEAN) : SituationError;

(* Set a callback to run just before shutdown. *)
PROCEDURE SituationSetExitCallback (user_data: ADDRESS);

(* Set a callback for file drop events. *)
PROCEDURE SituationSetFileDropCallback (callback: SituationFileDropCallback; user_data: ADDRESS);

(* Set a callback for window focus events. *)
PROCEDURE SituationSetFocusCallback (callback: SituationFocusCallback; user_data: ADDRESS);

(* Load a new set of gamepad mappings from a string. *)
PROCEDURE SituationSetGamepadMappings () : INTEGER;

(* Set gamepad vibration/rumble (Windows only). *)
PROCEDURE SituationSetGamepadVibration (jid: INTEGER; left_motor: REAL; right_motor: REAL) : BOOLEAN;

(* Designate the Sound Source node in the active graph to receive routed SFX tones. *)
PROCEDURE SituationSetGraphSFXSource (handle: SituationNodeHandle) : SituationError;

(* Set a callback for joystick connection events. *)
PROCEDURE SituationSetJoystickCallback (callback: SituationJoystickCallback; user_data: ADDRESS);

(* Set a callback for key events. *)
PROCEDURE SituationSetKeyCallback (callback: SituationKeyCallback; user_data: ADDRESS);

(* Set a callback for window maximize / restore events. *)
PROCEDURE SituationSetMaximizeCallback (callback: SituationMaximizeCallback; user_data: ADDRESS);

(* Set a callback for mouse button events. *)
PROCEDURE SituationSetMouseButtonCallback (callback: SituationMouseButtonCallback; user_data: ADDRESS);

(* Set a software offset for the mouse position. *)
PROCEDURE SituationSetMouseOffset (offset: Vector2);

(* Set the mouse position within the window. *)
PROCEDURE SituationSetMousePosition (pos: Vector2);

(* Set a software scale for the mouse position and delta. *)
PROCEDURE SituationSetMouseScale (scale: Vector2);

(* Filter MIDI to channel 0-15, or -1 omni. *)
PROCEDURE SituationSetNodeMidiChannel (graph: SituationAudioGraph; handle: SituationNodeHandle; channel: INTEGER) : SituationError;

(* Helper to set a specific pixel color (CPU-side). *)
PROCEDURE SituationSetPixelColor (x: INTEGER; y: INTEGER; col: ColorRGBA);

(* Set a callback for window framebuffer resize events. *)
PROCEDURE SituationSetResizeCallback (user_data: ADDRESS);

(* Set the default screenshot file format (default: BMP). *)
PROCEDURE SituationSetScreenshotFormat (format: SituationScreenshotFormat);

(* Set a callback for mouse scroll events. *)
PROCEDURE SituationSetScrollCallback (callback: SituationScrollCallback; user_data: ADDRESS);

(* [OpenGL] Set a standalone uniform by name (location cache). While a frame is active, defers to SIT_OP_SET_UNIFORM. *)
PROCEDURE SituationSetShaderUniform (shader: SituationShader; uniform_name: ADDRESS; data: ADDRESS; type: SituationUniformType) : SituationError;

(* [OpenGL] Set float uniform array. *)
PROCEDURE SituationSetShaderUniform1fv (shader: SituationShader; uniform_name: ADDRESS; count: INTEGER; values: REALPtr) : SituationError;

(* [OpenGL] Set int uniform array in one call (e.g. name "uWallRows[0]", count=24). While a frame is active, records SIT_OP_SET_UNIFORM (same as render-thread mode). *)
PROCEDURE SituationSetShaderUniform1iv (shader: SituationShader; uniform_name: ADDRESS; count: INTEGER; values: INTEGERPtr) : SituationError;

(* [OpenGL] Set uniform by explicit location (SPIR-V layout(location=)); defers during frames like SituationSetShaderUniform. *)
PROCEDURE SituationSetShaderUniformLocation (shader: SituationShader; location: INTEGER; data: ADDRESS; type: SituationUniformType) : SituationError;

(* [OpenGL] Set mat4 uniform array. *)
PROCEDURE SituationSetShaderUniformMatrix4fv (shader: SituationShader; uniform_name: ADDRESS; count: INTEGER; matrices: Mat4Ptr) : SituationError;

(* Apply an echo effect to a sound. *)
PROCEDURE SituationSetSoundEcho (sound: SituationSoundPtr; enabled: BOOLEAN; delay_sec: REAL; feedback: REAL; wet_mix: REAL) : SituationError;

(* Apply a low-pass or high-pass filter to a sound. *)
PROCEDURE SituationSetSoundFilter (sound: SituationSoundPtr; type: SituationFilterType; cutoff_hz: REAL; q_factor: REAL) : SituationError;

(* Set the stereo pan for a sound [-1.0 to 1.0]. *)
PROCEDURE SituationSetSoundPan (sound: SituationSoundPtr; pan: REAL) : SituationError;

(* Set the pitch for a sound (resamples). *)
PROCEDURE SituationSetSoundPitch (sound: SituationSoundPtr; pitch: REAL) : SituationError;

(* Apply a reverb effect to a sound. *)
PROCEDURE SituationSetSoundReverb (sound: SituationSoundPtr; enabled: BOOLEAN; room_size: REAL; damping: REAL; wet_mix: REAL; dry_mix: REAL) : SituationError;

(* Set the volume for a specific sound. *)
PROCEDURE SituationSetSoundVolume (sound: SituationSoundPtr; volume: REAL) : SituationError;

(* Set a desired frame rate cap (0 for uncapped). *)
PROCEDURE SituationSetTargetFPS (fps: INTEGER);

(* [Phase 2] Update sampler state. *)
PROCEDURE SituationSetTextureSamplerParams (texture: SituationTexture; min_filter: SituationTextureFilter; mag_filter: SituationTextureFilter; wrap_s: SituationTextureWrap; wrap_t: SituationTextureWrap) : SituationError;

(* Pins the CURRENT thread (logical CPU bitmask, bits 0..63) *)
PROCEDURE SituationSetThreadAffinity (core_mask: LONGCARD) : SituationError;

(* Set affinity; optional previous mask *)
PROCEDURE SituationSetThreadAffinityEx (core_mask: LONGCARD; out_previous: LONGCARDPtr) : SituationError;

(* Set the period of an oscillator. *)
PROCEDURE SituationSetTimerOscillatorPeriod (oscillator_id: INTEGER; period_seconds: LONGREAL) : SituationError;

(* Route a procedural tone to the active graph's SFX sound source. *)
PROCEDURE SituationSetToneRouting (handle: SituationToneHandle; route_to_graph: BOOLEAN) : SituationError;

(* Set the minimum log level for output filtering. *)
PROCEDURE SituationSetTraceLogLevel (logType: INTEGER);

(* Enable or disable VSync (vertical synchronization). *)
PROCEDURE SituationSetVSync (enable: BOOLEAN);

(* Tier B storage-only attachment defaults. *)
PROCEDURE SituationSetVirtualDisplayAttachmentDefaults (display_id: INTEGER; defaults: SituationVirtualDisplayAttachmentDefaults) : SituationError;

(* Mark a virtual display as needing to be re-rendered. *)
PROCEDURE SituationSetVirtualDisplayDirty (display_id: INTEGER; is_dirty: BOOLEAN);

(* SOLID idle tint (normalized by compositor). *)
PROCEDURE SituationSetVirtualDisplayFallbackColor (display_id: INTEGER; color: ColorRGBA);

(* SOLID, COLORBURST, or PATTERN when idle. *)
PROCEDURE SituationSetVirtualDisplayFallbackMode (display_id: INTEGER; mode: SituationVDFallbackMode);

(* Set idle threshold for compositor fallback (Phase 2a). *)
PROCEDURE SituationSetVirtualDisplayIdleThreshold (display_id: INTEGER; threshold_seconds: LONGREAL);

(* Full standby tuning + PATTERN mode. *)
PROCEDURE SituationSetVirtualDisplayPatternConfig (display_id: INTEGER; config: SitVdStandbyConfigPtr);

(* Toggle bitmask + PATTERN fallback (plan §3.4). *)
PROCEDURE SituationSetVirtualDisplayPatternLayers (display_id: INTEGER; pattern_layers: INTEGER);

(* Set the scaling/filtering mode for a virtual display. *)
