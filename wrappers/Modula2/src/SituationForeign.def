PROCEDURE SituationCmdBindMeshPullBuffers (cmd: SituationCommandBuffer; mesh: SituationMesh) : SituationError;

(* [GL+VK] Binds a graphics pipeline (shader program) for subsequent draws. *)
PROCEDURE SituationCmdBindPipeline (cmd: SituationCommandBuffer; shader: SituationShader) : SituationError;

