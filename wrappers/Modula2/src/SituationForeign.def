(* Set the window to be focused. *)
PROCEDURE SituationSetWindowFocused ();

(* Set the icon for the window (single image). *)
PROCEDURE SituationSetWindowIcon (image: SituationImage);

(* Set the icon for the window (multiple sizes). *)
PROCEDURE SituationSetWindowIcons (count: INTEGER);

(* Set the window maximum dimensions. *)
PROCEDURE SituationSetWindowMaxSize (width: INTEGER; height: INTEGER);

(* Set the window minimum dimensions. *)
PROCEDURE SituationSetWindowMinSize (width: INTEGER; height: INTEGER);

(* Set the window to be fullscreen on a specific monitor. *)
PROCEDURE SituationSetWindowMonitor (monitor_id: INTEGER);

(* Set window opacity [0.0f to 1.0f]. *)
PROCEDURE SituationSetWindowOpacity (opacity: REAL);

(* Set the window position on the screen. *)
PROCEDURE SituationSetWindowPosition (x: INTEGER; y: INTEGER);

(* Set the window dimensions. *)
