PROCEDURE SituationStopLoadedSound (sound: SituationSoundPtr) : SituationError;

(* Gracefully stop a tone by triggering its release envelope. Invalid handles are ignored. *)
PROCEDURE SituationStopTone (handle: SituationToneHandle);

(* Submits a job with priority flags and optional data payload. *)
PROCEDURE SituationSubmitJobEx (pool: SituationThreadPool; data: ADDRESS; data_size: ADDRESS; flags: SituationJobFlags) : SituationJobId;

(* Submit a render list for async recording on a worker thread. *)
PROCEDURE SituationSubmitRenderList (pool: SituationThreadPool; list: SituationRenderList; user_data: ADDRESS) : SituationJobId;

(* Take a screenshot. fileName is the base name (no extension) or NULL for auto-name. Extension added from format setting. *)
PROCEDURE SituationTakeScreenshot () : SituationError;

(* Close and destroy the virtual loopback devices. *)
PROCEDURE SituationTeardownVirtualMidiLoopback ();

(* Get the period of an oscillator in seconds. *)
PROCEDURE SituationTimerGetOscillatorPeriod (oscillator_id: INTEGER) : LONGREAL;

(* Get the current binary state (0 or 1) of an oscillator. *)
PROCEDURE SituationTimerGetOscillatorState (oscillator_id: INTEGER) : BOOLEAN;

(* Get the total number of times an oscillator has triggered. *)
PROCEDURE SituationTimerGetOscillatorTriggerCount (oscillator_id: INTEGER) : LONGCARD;

(* Get progress [0.0 to 1.0+] of the interval since the last successful ping. *)
PROCEDURE SituationTimerGetPingProgress (oscillator_id: INTEGER) : LONGREAL;

(* Get the previous frame's state of an oscillator. *)
PROCEDURE SituationTimerGetPreviousOscillatorState (oscillator_id: INTEGER) : BOOLEAN;

(* Get the total time elapsed since initialization. *)
PROCEDURE SituationTimerGetTime () : LONGREAL;

(* Check if an oscillator's state has changed this frame. *)
PROCEDURE SituationTimerHasOscillatorUpdated (oscillator_id: INTEGER) : BOOLEAN;

(* Check if an oscillator's period has elapsed since the last ping. *)
PROCEDURE SituationTimerPingOscillator (oscillator_id: INTEGER) : BOOLEAN;

(* Toggle window between borderless and decorated mode. *)
PROCEDURE SituationToggleBorderlessWindowed ();

(* Toggle window between fullscreen and windowed mode. *)
PROCEDURE SituationToggleFullscreen ();

(* Toggle flags in the current profile and apply the result. *)
PROCEDURE SituationToggleWindowStateFlags (flags_to_toggle: SituationWindowStateFlags) : SituationError;

(* Re-sort the graph processing order after topology changes. Call from the main thread after CreateNode/DestroyNode/CreatePatch/RemovePatch. *)
PROCEDURE SituationTopologicalSort (graph: SituationAudioGraph) : SituationError;

(* Unload audio by handle and free resources. *)
PROCEDURE SituationUnloadAudio (handle: SituationSoundHandle);

(* Unload the file path list returned by SituationLoadDroppedFiles. *)
PROCEDURE SituationUnloadDroppedFiles (paths: ADDRESS; count: INTEGER);

(* Frees CPU font data, glyph metrics, and owned GPU atlas (not the built-in default). *)
PROCEDURE SituationUnloadFont (font: SituationFont);

(* Unload an image's pixel data from memory. *)
PROCEDURE SituationUnloadImage (image: SituationImage);

(* Frees all GPU and CPU resources associated with a loaded model. *)
PROCEDURE SituationUnloadModel (model: SituationModel);

(* Unload a graphics shader pipeline and free its GPU resources. *)
PROCEDURE SituationUnloadShader (shader: SituationShaderPtr);

(* Unload a sound and free its resources. *)
PROCEDURE SituationUnloadSound (sound: SituationSoundPtr);

PROCEDURE SituationUpdate ();
(* Update data in a GPU buffer. *)
PROCEDURE SituationUpdateBuffer (buffer: SituationBuffer; offset: ADDRESS; size: ADDRESS; data: ADDRESS) : SituationError;

(* [Main thread] Update all internal timers (frame timer, temporal system). Call after polling events. *)
PROCEDURE SituationUpdateTimers ();

(* Returns first missing/wrong-type uniform, or SUCCESS if all resolved. *)
PROCEDURE SituationValidateShaderUniforms (shader: SituationShader; table: SituationUniformExpectation; table_count: INTEGER; error_buf: ADDRESS; error_buf_size: ADDRESS) : SituationError;

(* CC (e.g. mod wheel, expression). *)
PROCEDURE SituationVirtualMidiControlChange (channel: CARDINAL8; controller: CARDINAL8; value: CARDINAL8) : SituationError;

(* Inject note-off on channel 0 (legacy wrapper). *)
PROCEDURE SituationVirtualMidiNoteOff (note: CARDINAL8) : SituationError;

(* Channel-aware note-off (0-15). *)
PROCEDURE SituationVirtualMidiNoteOffEx (channel: CARDINAL8; note: CARDINAL8) : SituationError;

(* Inject note-on on channel 0 (legacy wrapper). *)
PROCEDURE SituationVirtualMidiNoteOn (note: CARDINAL8; velocity: CARDINAL8) : SituationError;

(* Channel-aware note-on (0-15). *)
PROCEDURE SituationVirtualMidiNoteOnEx (channel: CARDINAL8; note: CARDINAL8; velocity: CARDINAL8) : SituationError;

(* Pitch bend 0..16383 (center 8192). *)
PROCEDURE SituationVirtualMidiPitchBend (channel: CARDINAL8; bend: INTEGER16) : SituationError;

(* Program change on channel 0-15. *)
PROCEDURE SituationVirtualMidiProgramChange (channel: CARDINAL8; program: CARDINAL8) : SituationError;

(* Blocks until all queued jobs are finished. *)
PROCEDURE SituationWaitForAllJobs (pool: SituationThreadPool);

(* Waits for a specific job to complete (O(1) check). *)
PROCEDURE SituationWaitForJob (pool: SituationThreadPool; job_id: SituationJobId) : SituationError;

(* Check if the application should close (e.g., user clicked X). *)
PROCEDURE SituationWindowShouldClose () : BOOLEAN;

(* Scale Q (chroma amplitude); preserve luma and phase. *)
PROCEDURE SituationYpqAdjustChroma (color: ColorYPQA; chroma_factor: REAL) : ColorYPQA;

(* Scale Y (luma); preserve phase and chroma. *)
PROCEDURE SituationYpqAdjustLuma (color: ColorYPQA; luma_factor: REAL) : ColorYPQA;

(* Rotate hue; P shifts by byte steps mod 256. *)
PROCEDURE SituationYpqAdjustPhase (color: ColorYPQA; phase_shift: INTEGER) : ColorYPQA;

PROCEDURE SituationYpqAnalyzeRgbMapping (out: SituationYpqRgbMappingStats) : SituationError;
(* Reduce chroma if linear RGB would clip. *)
PROCEDURE SituationYpqClampInGamut (ypq: ColorYPQf) : ColorYPQf;

(* Weighted distance in YPQ space. *)
PROCEDURE SituationYpqDistance (a: ColorYPQA; b: ColorYPQA) : REAL;

(* Per-channel tolerance compare. *)
PROCEDURE SituationYpqEquals (a: ColorYPQA; b: ColorYPQA; tolerance: CARDINAL8) : BOOLEAN;

(* Normalized chroma amplitude [0, 1]. *)
PROCEDURE SituationYpqGetChroma (color: ColorYPQA) : REAL;

(* Hue in degrees [0, 360). *)
PROCEDURE SituationYpqGetHueDegrees (color: ColorYPQA) : REAL;

(* Normalized luma [0, 1]. *)
PROCEDURE SituationYpqGetLuma (color: ColorYPQA) : REAL;

(* Interpolate YPQ; phase uses shortest arc on the hue wheel. *)
PROCEDURE SituationYpqLerp (a: ColorYPQA; b: ColorYPQA; t: REAL) : ColorYPQA;

(* Float YPQ → 8-bit ColorYPQA. *)
PROCEDURE SituationYpqQuantize (ypq: ColorYPQf) : ColorYPQA;

PROCEDURE SituationYpqSliceDuplicateCount (axis: CHAR; value: INTEGER; out_dup: INTEGERPtr) : SituationError;
(* Float YPQ → A2R10G10B10 packed pixel (10-bit SDR). *)
PROCEDURE SituationYpqToRgb10Packed (ypq: ColorYPQf) : CARDINAL;

(* Float YPQ → PQ-encoded A2R10G10B10 (HDR10 swapchain). *)
PROCEDURE SituationYpqToRgb10PackedHdr (ypq: ColorYPQf) : CARDINAL;

(* Float YPQ → 10-bit RGBA (linear YIQ, clamped). *)
PROCEDURE SituationYpqToRgba10 (ypq: ColorYPQf) : ColorRGBA10;

END SituationForeign.
