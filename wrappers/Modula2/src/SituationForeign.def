(* [GL+VK] Prepare the backend for a new frame of rendering commands. *)
PROCEDURE SituationAcquireFrameCommandBuffer () : SituationError;

(* Adds multiple dependencies for a single dependent job. *)
PROCEDURE SituationAddJobDependencies (pool: SituationThreadPool; prerequisites: SituationJobIdPtr; count: INTEGER; dependent_job: SituationJobId) : SituationError;

(* Adds a dependency between two jobs (prereq -> dependent). *)
PROCEDURE SituationAddJobDependency (pool: SituationThreadPool; prerequisite_job: SituationJobId; dependent_job: SituationJobId) : SituationError;

(* Manually apply the appropriate window state profile based on current focus. *)
PROCEDURE SituationApplyCurrentProfileWindowState () : SituationError;

(* Attach a custom DSP processor to a sound's effect chain. *)
PROCEDURE SituationAttachAudioProcessor (sound: SituationSoundPtr; processor: SituationAudioProcessorCallback; user_data: ADDRESS) : SituationError;

(* Convenience: auto-select first available MIDI input. Equivalent to EnableMidiControl(..., -1). *)
PROCEDURE SituationAutoConnectMidi (graph: SituationAudioGraph; handle: SituationNodeHandle) : SituationError;

(* Upload bitmap_data as a NEAREST-filtered grid atlas for GPU text. *)
PROCEDURE SituationBakeBitmapFontAtlas (font: SituationFontPtr) : SituationError;

(* Rasterize a font into a GPU-ready atlas at the given size. *)
PROCEDURE SituationBakeFontAtlas (font: SituationFontPtr; fontSizePixels: REAL) : SituationError;

(* Start non-blocking GLSL load: [OpenGL] async compile/link; [Vulkan] shaderc on worker thread, pipelines on next frames. Poll with SituationPollShaderLoad. *)
PROCEDURE SituationBeginLoadShaderFromMemory (vs_code: ADDRESS; fs_code: ADDRESS; out_shader: SituationShaderPtr) : SituationError;

(* [Vulkan] Non-blocking pipeline build from in-memory SPIR-V (bytecode copied). [OpenGL] blocking SPIR-V load (unchanged). *)
PROCEDURE SituationBeginLoadShaderFromSpirvMemory (vs_spirv: ADDRESS; vs_len: ADDRESS; fs_spirv: ADDRESS; fs_len: ADDRESS; out_shader: SituationShaderPtr) : SituationError;

(* [Vulkan] Async SPIR-V with layout profile (e.g. UBO_SSBO for Demon Hunt). [OpenGL] profile ignored; same as SituationBeginLoadShaderFromSpirvMemory. *)
PROCEDURE SituationBeginLoadShaderFromSpirvMemoryEx (vs_spirv: ADDRESS; vs_len: ADDRESS; fs_spirv: ADDRESS; fs_len: ADDRESS; layout_profile: SituationSpirvLayoutProfile; out_shader: SituationShaderPtr) : SituationError;

(* [OpenGL] glShaderStorageBlockBinding for SPIR-V when reflection reports binding 0 for layout(binding=N). *)
PROCEDURE SituationBindShaderStorageBlock (shader: SituationShader; block_name: ADDRESS; binding_point: CARDINAL) : SituationError;

(* [OpenGL] glUniformBlockBinding for std140 UBO blocks (layout(binding=N)). *)
PROCEDURE SituationBindUniformBlock (shader: SituationShader; block_name: ADDRESS; binding_point: CARDINAL) : SituationError;

(* Copies raw byte data into a specific region of an image. *)
PROCEDURE SituationBlitRawDataToImage (data: ADDRESS; x: INTEGER; y: INTEGER; width: INTEGER; height: INTEGER; src_channels: INTEGER);

(* All logical CPUs on a NUMA node *)
PROCEDURE SituationBuildNumaNodeMask (numa_node_index: INTEGER) : LONGCARD;

(* All logical CPUs on one physical core *)
PROCEDURE SituationBuildPhysicalCoreMask (physical_core_index: INTEGER) : LONGCARD;

(* One LP per core *)
PROCEDURE SituationBuildUniqueCoreMask (start_physical_core: INTEGER; count: INTEGER; avoid_siblings: BOOLEAN) : LONGCARD;

PROCEDURE SituationCameraBuildInvViewProj (desc: SituationCameraDesc; out_inv_vp: Mat4);
PROCEDURE SituationCameraBuildProj (desc: SituationCameraDesc; out_proj: Mat4);
PROCEDURE SituationCameraBuildView (desc: SituationCameraDesc; out_view: Mat4);
PROCEDURE SituationCameraBuildViewProj (desc: SituationCameraDesc; out_vp: Mat4);
PROCEDURE SituationCameraUnprojectPixel (desc: SituationCameraDesc; inv_vp: Mat4; pixel: Vector2; framebuffer_px: Vector2; out_ray_origin: Vector3Ptr; out_ray_dir: Vector3Ptr);
(* Cancel an active learn operation. *)
